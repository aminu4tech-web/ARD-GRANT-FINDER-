<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ARD GRANT FINDER - Official Nigerian Opportunities Platform</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        darkNavy: '#040D1A',
                        navy: '#0A192F',
                        royalBlue: '#1E3A8A',
                        blue: '#2563EB',
                        gold: '#D4AF37',
                        goldHover: '#B59226',
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <!-- Font Awesome CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
        .view-section { display: none; }
        .view-section.active { display: block; }
    </style>
</head>
<body class="bg-darkNavy text-slate-100 min-h-screen flex flex-col selection:bg-gold selection:text-darkNavy">

    <!-- NAVIGATION BAR -->
    <header class="bg-navy border-b border-slate-800 sticky top-0 z-50 shadow-md">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <a href="#home" onclick="switchView('home')" class="flex items-center gap-3 group">
                <div class="w-10 h-10 rounded-xl bg-gold flex items-center justify-center font-bold text-darkNavy text-xl shadow-lg group-hover:scale-105 transition-transform">A</div>
                <div>
                    <span class="text-xl font-extrabold text-white tracking-wide block">ARD GRANT FINDER</span>
                    <span class="text-[10px] text-gold uppercase tracking-widest block font-semibold">Nigerian Opportunities Gateway</span>
                </div>
            </a>

            <!-- Desktop Links -->
            <nav class="hidden lg:flex items-center gap-6 text-sm font-medium">
                <a href="#home" onclick="switchView('home')" class="text-slate-300 hover:text-gold transition-colors">Home</a>
                <a href="#directory" onclick="switchView('directory')" class="text-slate-300 hover:text-gold transition-colors">Directory</a>
                <a href="#directory" onclick="filterByCategory('government')" class="text-slate-300 hover:text-gold transition-colors">Govt Recruitment</a>
                <a href="#directory" onclick="filterByCategory('empowerment')" class="text-slate-300 hover:text-gold transition-colors">Empowerment</a>
                <a href="#dashboard" onclick="switchView('dashboard')" class="text-slate-300 hover:text-gold transition-colors">Dashboard</a>
                <a href="#admin" onclick="switchView('admin')" class="text-slate-300 hover:text-gold transition-colors">Admin</a>
            </nav>

            <!-- Auth Buttons & Mobile Menu Trigger -->
            <div class="hidden lg:flex items-center gap-3">
                <div id="authNavButtons" class="flex items-center gap-3">
                    <a href="#login" onclick="switchView('login')" class="px-4 py-2 text-slate-300 hover:text-white border border-slate-700 hover:border-slate-500 rounded-xl text-sm font-semibold transition">Sign In</a>
                    <a href="#register" onclick="switchView('register')" class="px-4 py-2 bg-gold hover:bg-goldHover text-darkNavy font-bold rounded-xl text-sm transition shadow-md">Create Account</a>
                </div>
                <div id="userNavSession" class="hidden items-center gap-3">
                    <span id="navUserEmailDisplay" class="text-xs text-gold font-medium"></span>
                    <button onclick="handleSignOut()" class="px-3 py-1.5 bg-red-900/30 border border-red-500/50 hover:bg-red-900/60 text-red-200 text-xs font-semibold rounded-lg transition">Sign Out</button>
                </div>
            </div>

            <button onclick="toggleMobileMenu()" class="lg:hidden text-slate-300 hover:text-white p-2 focus:outline-none">
                <i id="mobileMenuIcon" class="fa-solid fa-bars text-2xl"></i>
            </button>
        </div>

        <!-- Mobile Menu -->
        <div id="mobileMenu" class="hidden lg:hidden bg-navy border-b border-slate-800 px-4 pt-2 pb-6 space-y-3">
            <a href="#home" onclick="switchView('home'); toggleMobileMenu();" class="block py-2 text-slate-300 hover:text-gold">Home</a>
            <a href="#directory" onclick="switchView('directory'); toggleMobileMenu();" class="block py-2 text-slate-300 hover:text-gold">Directory</a>
            <a href="#dashboard" onclick="switchView('dashboard'); toggleMobileMenu();" class="block py-2 text-slate-300 hover:text-gold">Dashboard</a>
            <a href="#admin" onclick="switchView('admin'); toggleMobileMenu();" class="block py-2 text-slate-300 hover:text-gold">Admin Portal</a>
            <div id="mobileAuthContainer" class="pt-4 border-t border-slate-800 flex flex-col gap-2">
                <a href="#login" onclick="switchView('login'); toggleMobileMenu();" class="w-full text-center py-2.5 text-slate-300 border border-slate-700 rounded-xl text-sm">Sign In</a>
                <a href="#register" onclick="switchView('register'); toggleMobileMenu();" class="w-full text-center py-2.5 bg-gold text-darkNavy font-bold rounded-xl text-sm">Create Account</a>
            </div>
        </div>
    </header>

    <!-- MAIN APP CONTAINER -->
    <main class="flex-grow">

        <!-- 1. HOMEPAGE VIEW -->
        <section id="view-home" class="view-section active">
            <div class="py-20 px-4 text-center bg-gradient-to-b from-navy to-darkNavy border-b border-slate-800/60">
                <div class="max-w-4xl mx-auto">
                    <span class="bg-royalBlue/40 text-gold text-xs font-semibold px-4 py-1.5 rounded-full border border-gold/30 inline-flex items-center gap-2 mb-6">
                        <i class="fa-solid fa-shield-halved"></i> Single Source of Verified Nigerian Opportunities
                    </span>
                    <h1 class="text-4xl md:text-6xl font-extrabold text-white tracking-tight mb-6">Verified Nigerian Grants & Opportunities</h1>
                    <p class="text-lg text-slate-300 mb-10 max-w-2xl mx-auto leading-relaxed">Discover grants, scholarships, jobs, government recruitment, empowerment programmes and skills opportunities in one centralized platform.</p>
                    
                    <div class="bg-navy/90 p-3 rounded-2xl border border-slate-700 shadow-2xl max-w-3xl mx-auto flex flex-col md:flex-row gap-3">
                        <div class="relative flex-grow">
                            <i class="fa-solid fa-magnifying-glass absolute left-4 top-3.5 text-slate-400"></i>
                            <input type="text" id="homeSearchInput" placeholder="Search grants, 3MTT, SMEDAN, scholarships..." class="w-full bg-darkNavy border border-slate-700 text-white pl-11 pr-4 py-3 rounded-xl focus:outline-none focus:border-gold text-sm">
                        </div>
                        <button onclick="executeHomeSearch()" class="bg-gold hover:bg-goldHover text-darkNavy font-bold px-8 py-3 rounded-xl text-sm transition shadow-lg">Search Now</button>
                    </div>
                </div>
            </div>

            <!-- Stats Bar -->
            <div class="max-w-7xl mx-auto px-4 py-12 grid grid-cols-2 md:grid-cols-4 gap-6">
                <div class="bg-navy/50 p-6 rounded-2xl border border-slate-800 text-center shadow-md">
                    <h3 class="text-3xl font-extrabold text-gold mb-1">Official</h3>
                    <p class="text-slate-400 text-xs uppercase tracking-wider">Source Links</p>
                </div>
                <div class="bg-navy/50 p-6 rounded-2xl border border-slate-800 text-center shadow-md">
                    <h3 class="text-3xl font-extrabold text-gold mb-1">36 States</h3>
                    <p class="text-slate-400 text-xs uppercase tracking-wider">Plus FCT Covered</p>
                </div>
                <div class="bg-navy/50 p-6 rounded-2xl border border-slate-800 text-center shadow-md">
                    <h3 class="text-3xl font-extrabold text-gold mb-1">6+</h3>
                    <p class="text-slate-400 text-xs uppercase tracking-wider">Opportunity Sectors</p>
                </div>
                <div class="bg-navy/50 p-6 rounded-2xl border border-slate-800 text-center shadow-md">
                    <h3 class="text-3xl font-extrabold text-gold mb-1">Live</h3>
                    <p class="text-slate-400 text-xs uppercase tracking-wider">Status Tracking</p>
                </div>
            </div>

            <!-- Categories Grid -->
            <div class="max-w-7xl mx-auto px-4 py-12">
                <div class="flex justify-between items-end mb-8">
                    <div>
                        <span class="text-xs text-gold uppercase tracking-widest font-semibold block mb-1">Categories</span>
                        <h2 class="text-2xl md:text-3xl font-bold text-white">Explore Opportunities</h2>
                    </div>
                    <button onclick="switchView('directory')" class="text-gold text-sm font-semibold hover:underline">View All Directory →</button>
                </div>
                <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4" id="homeCategoriesGrid"></div>
            </div>

            <!-- Featured Opportunities -->
            <div class="max-w-7xl mx-auto px-4 py-12 border-t border-slate-800/60">
                <div class="flex justify-between items-end mb-8">
                    <div>
                        <span class="text-xs text-gold uppercase tracking-widest font-semibold block mb-1">Curated Records</span>
                        <h2 class="text-2xl md:text-3xl font-bold text-white">Featured Opportunities</h2>
                    </div>
                    <button onclick="switchView('directory')" class="text-gold text-sm font-semibold hover:underline">Browse All Records →</button>
                </div>
                <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6" id="homeFeaturedGrid"></div>
            </div>
        </section>

        <!-- 2. OPPORTUNITY DIRECTORY VIEW -->
        <section id="view-directory" class="view-section">
            <div class="max-w-7xl mx-auto px-4 py-10">
                <div class="mb-8">
                    <h1 class="text-3xl font-extrabold text-white mb-2">Opportunity Directory</h1>
                    <p class="text-slate-400 text-sm">Filter and search verified Nigerian grants, jobs, scholarships, and programmes.</p>
                </div>

                <!-- Filters -->
                <div class="bg-navy p-6 rounded-2xl border border-slate-800 shadow-xl grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4 mb-8">
                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">Keyword Search</label>
                        <input type="text" id="dirSearch" placeholder="Search title, agency..." class="w-full bg-darkNavy border border-slate-700 px-3 py-2.5 rounded-xl text-white text-sm focus:outline-none focus:border-gold">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">Category</label>
                        <select id="dirCategory" class="w-full bg-darkNavy border border-slate-700 px-3 py-2.5 rounded-xl text-white text-sm focus:outline-none focus:border-gold">
                            <option value="">All Categories</option>
                            <option value="grants">Grants</option>
                            <option value="scholarships">Scholarships</option>
                            <option value="jobs">Jobs</option>
                            <option value="government">Government Recruitment</option>
                            <option value="empowerment">Empowerment</option>
                            <option value="skills">Skills & Training</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">State Location</label>
                        <select id="dirState" class="w-full bg-darkNavy border border-slate-700 px-3 py-2.5 rounded-xl text-white text-sm focus:outline-none focus:border-gold">
                            <option value="">All States / National</option>
                            <option value="National">National</option>
                            <option value="Abuja (FCT)">Abuja (FCT)</option>
                            <option value="Lagos">Lagos</option>
                            <option value="Kano">Kano</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">Status</label>
                        <select id="dirStatus" class="w-full bg-darkNavy border border-slate-700 px-3 py-2.5 rounded-xl text-white text-sm focus:outline-none focus:border-gold">
                            <option value="">All Statuses</option>
                            <option value="Open">Open</option>
                            <option value="Ongoing">Ongoing</option>
                            <option value="Status to be confirmed">Status to be confirmed</option>
                        </select>
                    </div>
                    <div class="flex items-end">
                        <button onclick="renderDirectoryGrid()" class="w-full bg-gold hover:bg-goldHover text-darkNavy font-bold py-2.5 rounded-xl text-sm transition shadow-md">Apply Filters</button>
                    </div>
                </div>

                <div id="directoryGrid" class="grid md:grid-cols-2 lg:grid-cols-3 gap-6"></div>
            </div>
        </section>

        <!-- 3. OPPORTUNITY DETAILS VIEW -->
        <section id="view-details" class="view-section">
            <div class="max-w-4xl mx-auto px-4 py-12">
                <button onclick="switchView('directory')" class="text-gold text-sm font-semibold mb-6 inline-flex items-center gap-2 hover:underline">
                    <i class="fa-solid fa-arrow-left"></i> Back to Directory
                </button>
                <div id="detailsContentBox" class="bg-navy p-8 md:p-10 rounded-3xl border border-slate-800 shadow-2xl"></div>
            </div>
        </section>

        <!-- 4. DASHBOARD VIEW -->
        <section id="view-dashboard" class="view-section">
            <div class="max-w-7xl mx-auto px-4 py-10">
                <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 gap-4 border-b border-slate-800 pb-6">
                    <div>
                        <h1 class="text-3xl font-extrabold text-white mb-1">ARD GRANT FINDER Dashboard</h1>
                        <p class="text-slate-400 text-sm">Welcome back, <span id="dashProfileName" class="text-gold font-semibold">User</span> (<span id="dashProfileEmail">email</span>)</p>
                    </div>
                    <button onclick="switchView('directory')" class="bg-gold text-darkNavy font-bold px-5 py-2.5 rounded-xl text-sm hover:bg-goldHover transition shadow-md">Browse Directory</button>
                </div>

                <div class="grid md:grid-cols-3 gap-6 mb-10">
                    <div class="bg-navy p-6 rounded-2xl border border-slate-800 shadow-md">
                        <span class="text-slate-400 text-xs font-semibold uppercase tracking-wider block mb-2">Saved Opportunities</span>
                        <p class="text-4xl font-extrabold text-gold" id="dashSavedCount">0</p>
                    </div>
                    <div class="bg-navy p-6 rounded-2xl border border-slate-800 shadow-md">
                        <span class="text-slate-400 text-xs font-semibold uppercase tracking-wider block mb-2">Total Indexed Records</span>
                        <p class="text-4xl font-extrabold text-blue" id="dashTotalCount">0</p>
                    </div>
                    <div class="bg-navy p-6 rounded-2xl border border-slate-800 shadow-md">
                        <span class="text-slate-400 text-xs font-semibold uppercase tracking-wider block mb-2">Account Status</span>
                        <p class="text-2xl font-bold text-green-400 mt-1">Verified Session</p>
                    </div>
                </div>

                <div>
                    <h2 class="text-xl font-bold text-white mb-4">Your Saved Opportunities</h2>
                    <div id="dashSavedList" class="grid md:grid-cols-2 lg:grid-cols-3 gap-6"></div>
                </div>
            </div>
        </section>

        <!-- 5. LOGIN VIEW -->
        <section id="view-login" class="view-section">
            <div class="max-w-md mx-auto px-4 py-20">
                <div class="bg-navy p-8 md:p-10 rounded-3xl border border-slate-800 shadow-2xl">
                    <h1 class="text-2xl font-bold text-white mb-1">Sign In</h1>
                    <p class="text-slate-400 text-sm mb-6">Sign in to access your dashboard and saved items.</p>

                    <div id="loginAlertBox" class="hidden p-3 mb-4 rounded-xl text-sm"></div>

                    <form onsubmit="handleUserLogin(event)" class="space-y-4">
                        <div>
                            <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">Email Address</label>
                            <input type="email" id="loginEmailInput" required placeholder="name@example.com" class="w-full bg-darkNavy border border-slate-700 px-4 py-3 rounded-xl text-white text-sm focus:outline-none focus:border-gold">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">Password</label>
                            <input type="password" id="loginPassInput" required placeholder="••••••••" class="w-full bg-darkNavy border border-slate-700 px-4 py-3 rounded-xl text-white text-sm focus:outline-none focus:border-gold">
                        </div>
                        <button type="submit" class="w-full bg-gold hover:bg-goldHover text-darkNavy font-bold py-3 rounded-xl text-sm transition shadow-lg">Sign In</button>
                    </form>

                    <div class="mt-6 text-center text-sm text-slate-400">
                        Don't have an account? <a href="#register" onclick="switchView('register')" class="text-gold font-semibold hover:underline">Create Account</a>
                    </div>
                </div>
            </div>
        </section>

        <!-- 6. REGISTER VIEW -->
        <section id="view-register" class="view-section">
            <div class="max-w-md mx-auto px-4 py-16">
                <div class="bg-navy p-8 md:p-10 rounded-3xl border border-slate-800 shadow-2xl">
                    <h1 class="text-2xl font-bold text-white mb-1">Create Account</h1>
                    <p class="text-slate-400 text-sm mb-6">Register to track verified Nigerian opportunities.</p>

                    <div id="registerAlertBox" class="hidden p-3 mb-4 rounded-xl text-sm"></div>

                    <form onsubmit="handleUserRegister(event)" class="space-y-4">
                        <div>
                            <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">Full Name</label>
                            <input type="text" id="regNameInput" required placeholder="John Doe" class="w-full bg-darkNavy border border-slate-700 px-4 py-3 rounded-xl text-white text-sm focus:outline-none focus:border-gold">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">Email Address</label>
                            <input type="email" id="regEmailInput" required placeholder="name@example.com" class="w-full bg-darkNavy border border-slate-700 px-4 py-3 rounded-xl text-white text-sm focus:outline-none focus:border-gold">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">Password</label>
                            <input type="password" id="regPassInput" required placeholder="••••••••" class="w-full bg-darkNavy border border-slate-700 px-4 py-3 rounded-xl text-white text-sm focus:outline-none focus:border-gold">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">Confirm Password</label>
                            <input type="password" id="regConfirmPassInput" required placeholder="••••••••" class="w-full bg-darkNavy border border-slate-700 px-4 py-3 rounded-xl text-white text-sm focus:outline-none focus:border-gold">
                        </div>
                        <div class="flex items-center gap-2">
                            <input type="checkbox" id="regTermsCheck" required class="rounded bg-darkNavy border-slate-700 text-gold focus:ring-gold">
                            <label for="regTermsCheck" class="text-xs text-slate-400">I agree to the <a href="#terms" onclick="switchView('terms')" class="text-gold hover:underline">Terms</a> and <a href="#privacy" onclick="switchView('privacy')" class="text-gold hover:underline">Privacy Policy</a>.</label>
                        </div>
                        <button type="submit" class="w-full bg-gold hover:bg-goldHover text-darkNavy font-bold py-3 rounded-xl text-sm transition shadow-lg">Create Account</button>
                    </form>

                    <div class="mt-6 text-center text-sm text-slate-400">
                        Already registered? <a href="#login" onclick="switchView('login')" class="text-gold font-semibold hover:underline">Sign In</a>
                    </div>
                </div>
            </div>
        </section>

        <!-- 7. ADMIN VIEW -->
        <section id="view-admin" class="view-section">
            <div class="max-w-6xl mx-auto px-4 py-10">
                <div class="flex justify-between items-center mb-6">
                    <div>
                        <h1 class="text-3xl font-extrabold text-white mb-1">Admin Portal</h1>
                        <p class="text-xs text-yellow-500 font-medium">* Frontend Prototype Administrator Dashboard</p>
                    </div>
                </div>
                <div class="bg-navy rounded-2xl border border-slate-800 shadow-xl overflow-hidden p-6">
                    <h2 class="text-lg font-bold text-white mb-4">Manage Opportunities Dataset</h2>
                    <div id="adminOpportunitiesList" class="space-y-3"></div>
                </div>
            </div>
        </section>

        <!-- 8. ABOUT VIEW -->
        <section id="view-about" class="view-section">
            <div class="max-w-4xl mx-auto px-4 py-12">
                <div class="bg-navy p-8 md:p-12 rounded-3xl border border-slate-800 shadow-2xl space-y-6">
                    <h1 class="text-3xl font-extrabold text-gold mb-2">About ARD GRANT FINDER</h1>
                    <p class="text-slate-300 leading-relaxed text-sm md:text-base">A centralized Nigerian opportunities discovery platform that helps users find grants, scholarships, jobs, government recruitment, empowerment programmes, and skills/training opportunities from official sources.</p>
                </div>
            </div>
        </section>

        <!-- 9. CONTACT VIEW -->
        <section id="view-contact" class="view-section">
            <div class="max-w-md mx-auto px-4 py-16">
                <div class="bg-navy p-8 md:p-10 rounded-3xl border border-slate-800 shadow-2xl">
                    <h1 class="text-2xl font-bold text-white mb-1">Contact Us</h1>
                    <p class="text-slate-400 text-sm mb-6">Have questions or feedback? Send us a note.</p>
                    <form onsubmit="event.preventDefault(); alert('Message sent successfully! (Prototype mode)');" class="space-y-4">
                        <input type="text" required placeholder="Full Name" class="w-full bg-darkNavy border border-slate-700 px-4 py-3 rounded-xl text-white text-sm focus:outline-none focus:border-gold">
                        <input type="email" required placeholder="name@example.com" class="w-full bg-darkNavy border border-slate-700 px-4 py-3 rounded-xl text-white text-sm focus:outline-none focus:border-gold">
                        <textarea required placeholder="Your message..." class="w-full bg-darkNavy border border-slate-700 px-4 py-3 rounded-xl text-white text-sm h-28 focus:outline-none focus:border-gold"></textarea>
                        <button type="submit" class="w-full bg-gold hover:bg-goldHover text-darkNavy font-bold py-3 rounded-xl text-sm transition shadow-lg">Send Message</button>
                    </form>
                </div>
            </div>
        </section>

        <!-- 10. PRIVACY VIEW -->
        <section id="view-privacy" class="view-section">
            <div class="max-w-3xl mx-auto px-4 py-12">
                <div class="bg-navy p-8 md:p-10 rounded-3xl border border-slate-800 shadow-2xl space-y-4 text-slate-300 text-sm leading-relaxed">
                    <h1 class="text-2xl font-bold text-white mb-4">Privacy Policy</h1>
                    <p>ARD GRANT FINDER respects your privacy and uses browser LocalStorage strictly for local user sessions and saved items.</p>
                </div>
            </div>
        </section>

        <!-- 11. TERMS VIEW -->
        <section id="view-terms" class="view-section">
            <div class="max-w-3xl mx-auto px-4 py-12">
                <div class="bg-navy p-8 md:p-10 rounded-3xl border border-slate-800 shadow-2xl space-y-4 text-slate-300 text-sm leading-relaxed">
                    <h1 class="text-2xl font-bold text-white mb-4">Terms of Service</h1>
                    <p>ARD GRANT FINDER is an opportunity discovery platform. Always verify requirements directly on official government or institutional websites.</p>
                </div>
            </div>
        </section>

    </main>

    <!-- FOOTER -->
    <footer class="bg-navy border-t border-slate-800 py-10 mt-auto text-slate-400 text-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid md:grid-cols-4 gap-8 mb-8">
            <div>
                <div class="flex items-center gap-3 mb-3">
                    <div class="w-8 h-8 rounded-lg bg-gold flex items-center justify-center font-bold text-darkNavy">A</div>
                    <span class="text-white font-bold text-lg">ARD GRANT FINDER</span>
                </div>
                <p class="text-xs text-slate-400 leading-relaxed">Single source of verified Nigerian grants, scholarships, jobs, and empowerment opportunities.</p>
            </div>
            <div>
                <h4 class="text-white font-semibold text-xs uppercase tracking-wider mb-3">Quick Links</h4>
                <ul class="space-y-2 text-xs">
                    <li><a href="#home" onclick="switchView('home')" class="hover:text-gold">Home</a></li>
                    <li><a href="#directory" onclick="switchView('directory')" class="hover:text-gold">Directory</a></li>
                    <li><a href="#dashboard" onclick="switchView('dashboard')" class="hover:text-gold">User Dashboard</a></li>
                </ul>
            </div>
            <div>
                <h4 class="text-white font-semibold text-xs uppercase tracking-wider mb-3">Legal & Info</h4>
                <ul class="space-y-2 text-xs">
                    <li><a href="#about" onclick="switchView('about')" class="hover:text-gold">About Us</a></li>
                    <li><a href="#contact" onclick="switchView('contact')" class="hover:text-gold">Contact</a></li>
                    <li><a href="#privacy" onclick="switchView('privacy')" class="hover:text-gold">Privacy Policy</a></li>
                    <li><a href="#terms" onclick="switchView('terms')" class="hover:text-gold">Terms of Service</a></li>
                </ul>
            </div>
            <div>
                <h4 class="text-white font-semibold text-xs uppercase tracking-wider mb-3">Notice</h4>
                <p class="text-xs text-slate-500 leading-relaxed">Always confirm application guidelines on official government domains before submitting confidential data.</p>
            </div>
        </div>
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 border-t border-slate-800/80 text-center text-xs text-slate-500">
            &copy; 2026 ARD GRANT FINDER. All rights reserved. Built for Nigerian Empowerment.
        </div>
    </footer>

    <!-- SCRIPT ENGINE -->
    <script>
        const DATASET_VERSION = 2;
        const DATASET_KEY = 'ardGrantFinderData';
        const VERSION_KEY = 'ardGrantFinderDataVersion';
        const SAVED_KEY = 'ardGrantFinderSavedOpportunities';
        const USERS_KEY = 'ardGrantFinderUsers';
        const CURRENT_USER_KEY = 'ardGrantFinderCurrentUser';

        const defaultOpportunities = [
            {
                id: 'opp-001',
                title: '3MTT Training Programme (3 Million Technical Talents)',
                organization: 'Federal Ministry of Communications, Innovation & Digital Economy',
                category: 'skills',
