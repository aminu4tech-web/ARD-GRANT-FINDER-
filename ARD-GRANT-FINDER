                featured: true,
                keywords: ['nelfund', 'education', 'loans', 'scholarships', 'students']
            },
            {
                id: 'opp-003',
                title: 'Nigeria Customs Service (NCS) Portal',
                organization: 'Nigeria Customs Service',
                category: 'government',
                providerType: 'Government',
                description: 'Official recruitment and institutional portal for the Nigeria Customs Service.',
                eligibility: 'Nigerian citizens meeting prescribed physical and academic qualifications.',
                location: 'Nationwide',
                state: 'National',
                deadline: 'Status to be confirmed',
                status: 'Status to be confirmed',
                verification: 'Official website listed',
                officialUrl: 'https://customs.gov.ng/',
                dateAdded: '2026-02-01',
                featured: true,
                keywords: ['customs', 'ncs', 'recruitment', 'government', 'jobs']
            },
            {
                id: 'opp-004',
                title: 'Nigeria Immigration Service (NIS) Portal',
                organization: 'Nigeria Immigration Service',
                category: 'government',
                providerType: 'Government',
                description: 'Official institutional and recruitment gateway for the Nigeria Immigration Service.',
                eligibility: 'Nigerian citizens who fulfill official service requirements.',
                location: 'Nationwide',
                state: 'National',
                deadline: 'Status to be confirmed',
                status: 'Status to be confirmed',
                verification: 'Official website listed',
                officialUrl: 'https://immigration.gov.ng/',
                dateAdded: '2026-02-05',
                featured: false,
                keywords: ['immigration', 'nis', 'recruitment', 'government', 'jobs']
            },
            {
                id: 'opp-005',
                title: 'SMEDAN Business Development Support & Grants',
                organization: 'Small and Medium Enterprises Development Agency of Nigeria',
                category: 'grants',
                providerType: 'Government',
                description: 'Institutional guidance, capacity building, and financial empowerment programs for MSMEs across Nigeria.',
                eligibility: 'Registered small business owners and entrepreneurs in Nigeria.',
                location: 'Nationwide',
                state: 'National',
                deadline: 'Status to be confirmed',
                status: 'Status to be confirmed',
                verification: 'Official website listed',
                officialUrl: 'https://smedan.gov.ng/',
                dateAdded: '2026-02-10',
                featured: true,
                keywords: ['smedan', 'msme', 'grants', 'business', 'empowerment']
            },
            {
                id: 'opp-006',
                title: 'Bank of Industry (BOI) MSME Matching Fund',
                organization: 'Bank of Industry',
                category: 'grants',
                providerType: 'Institution',
                description: 'Development financing and targeted funds for industrial development and enterprise expansion in Nigeria.',
                eligibility: 'Nigerian enterprises operating in manufacturing, agro-processing, and key growth sectors.',
                location: 'Nationwide',
                state: 'National',
                deadline: 'Status to be confirmed',
                status: 'Status to be confirmed',
                verification: 'Official website listed',
                officialUrl: 'https://www.boi.ng/',
                dateAdded: '2026-02-12',
                featured: false,
                keywords: ['boi', 'bank of industry', 'msme', 'loans', 'grants']
            }
        ];

        function getOpportunities() {
            const storedVersion = localStorage.getItem(VERSION_KEY);
            const storedData = localStorage.getItem(DATASET_KEY);
            if (!storedVersion || parseInt(storedVersion, 10) < DATASET_VERSION || !storedData) {
                localStorage.setItem(DATASET_KEY, JSON.stringify(defaultOpportunities));
                localStorage.setItem(VERSION_KEY, DATASET_VERSION.toString());
                return defaultOpportunities;
            }
            try { return JSON.parse(storedData); } catch (e) { return defaultOpportunities; }
        }

        function getOpportunityById(id) {
            return getOpportunities().find(o => String(o.id) === String(id)) || null;
        }

        function escapeHtml(str) {
            if (!str) return '';
            return String(str)
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }

        function switchView(viewName, paramId = null) {
            if ((viewName === 'dashboard' || viewName === 'admin') && !getCurrentUserSession()) {
                alert('Please sign in to access your dashboard.');
                switchView('login');
                return;
            }

            document.querySelectorAll('.view-section').forEach(el => el.classList.remove('active'));
            const target = document.getElementById(`view-${viewName}`);
            if (target) {
                target.classList.add('active');
                window.scrollTo({ top: 0, behavior: 'smooth' });
            }

            if (viewName === 'home') renderHomeViews();
            if (viewName === 'directory') renderDirectoryGrid();
            if (viewName === 'details' && paramId) renderDetailsView(paramId);
            if (viewName === 'dashboard') renderDashboardView();
            if (viewName === 'admin') renderAdminView();

            history.pushState(null, '', `#${viewName}`);
        }

        function renderHomeViews() {
            const cats = [
                { title: 'Grants', icon: 'fa-hand-holding-dollar', key: 'grants' },
                { title: 'Scholarships', icon: 'fa-graduation-cap', key: 'scholarships' },
                { title: 'Jobs', icon: 'fa-briefcase', key: 'jobs' },
                { title: 'Government', icon: 'fa-building-columns', key: 'government' },
                { title: 'Empowerment', icon: 'fa-rocket', key: 'empowerment' },
                { title: 'Skills & Training', icon: 'fa-laptop-code', key: 'skills' }
            ];

            document.getElementById('homeCategoriesGrid').innerHTML = cats.map(c => `
                <button onclick="filterByCategory('${c.key}'); switchView('directory');" class="bg-navy hover:bg-navy/80 p-5 rounded-2xl border border-slate-800 hover:border-gold/50 text-center transition group shadow-md">
                    <i class="fa-solid ${c.icon} text-gold text-2xl mb-3 group-hover:scale-110 transition-transform"></i>
                    <h3 class="font-semibold text-slate-200 text-sm">${c.title}</h3>
                </button>
            `).join('');

            const featured = getOpportunities().filter(o => o.featured).slice(0, 3);
            document.getElementById('homeFeaturedGrid').innerHTML = featured.map(o => createCardHtml(o)).join('');
        }

        function executeHomeSearch() {
            const query = document.getElementById('homeSearchInput').value;
            document.getElementById('dirSearch').value = query;
            switchView('directory');
            renderDirectoryGrid();
        }

        function filterByCategory(catKey) {
            const selectEl = document.getElementById('dirCategory');
            if (selectEl) selectEl.value = catKey;
            renderDirectoryGrid();
        }

        function renderDirectoryGrid() {
            const q = document.getElementById('dirSearch').value.toLowerCase();
            const cat = document.getElementById('dirCategory').value;
            const state = document.getElementById('dirState').value;
            const status = document.getElementById('dirStatus').value;

            let data = getOpportunities();

            if (q) data = data.filter(i => i.title.toLowerCase().includes(q) || i.description.toLowerCase().includes(q) || i.organization.toLowerCase().includes(q));
            if (cat) data = data.filter(i => i.category === cat);
            if (state) data = data.filter(i => i.state === state);
            if (status) data = data.filter(i => i.status === status);

            const grid = document.getElementById('directoryGrid');
            if (data.length === 0) {
                grid.innerHTML = `<div class="col-span-full py-16 text-center text-slate-400 bg-navy rounded-2xl border border-slate-800">No opportunities matching your filter criteria.</div>`;
                return;
            }
            grid.innerHTML = data.map(o => createCardHtml(o)).join('');
        }

        function createCardHtml(opp) {
            const isSaved = isOpportunitySaved(opp.id);
            return `
                <div class="bg-navy rounded-2xl border border-slate-800 p-6 flex flex-col justify-between shadow-xl hover:border-slate-700 transition">
                    <div>
                        <div class="flex justify-between items-start gap-2 mb-3">
                            <span class="text-[10px] text-gold font-bold uppercase tracking-wider bg-royalBlue/30 px-3 py-1 rounded-md border border-gold/20">
                                ${escapeHtml(opp.category)}
                            </span>
                            <span class="bg-slate-800 text-slate-300 text-xs px-2.5 py-1 rounded-full border border-slate-700">
                                ${escapeHtml(opp.status)}
                            </span>
                        </div>
                        <h3 class="text-lg font-bold text-white mb-1 leading-snug">${escapeHtml(opp.title)}</h3>
                        <p class="text-xs text-gold/80 font-medium mb-3">${escapeHtml(opp.organization)}</p>
                        <p class="text-slate-400 text-sm mb-4 line-clamp-2">${escapeHtml(opp.description)}</p>
                    </div>
                    <div class="border-t border-slate-800 pt-4 mt-auto">
                        <div class="flex items-center justify-between text-xs text-slate-400 mb-4">
                            <span><i class="fa-solid fa-location-dot text-gold/70 mr-1"></i> ${escapeHtml(opp.location)}</span>
                            <span><i class="fa-solid fa-shield-check text-blue mr-1"></i> ${escapeHtml(opp.verification)}</span>
                        </div>
                        <div class="flex items-center justify-between gap-2">
                            <button onclick="switchView('details', '${escapeHtml(opp.id)}')" class="text-gold text-sm font-semibold hover:underline flex items-center gap-1">
                                View Details <i class="fa-solid fa-arrow-right text-xs"></i>
                            </button>
                            <button onclick="toggleSaveOpportunity('${escapeHtml(opp.id)}')" class="text-xs px-3 py-1.5 rounded-lg border ${isSaved ? 'bg-gold/20 border-gold text-gold' : 'border-slate-700 text-slate-300 hover:border-gold hover:text-gold'} transition">
                                <i class="fa-${isSaved ? 'solid' : 'regular'} fa-bookmark mr-1"></i> ${isSaved ? 'Saved' : 'Save'}
                            </button>
                        </div>
                    </div>
                </div>
            `;
        }

        function renderDetailsView(id) {
            const opp = getOpportunityById(id);
            const box = document.getElementById('detailsContentBox');
            if (!opp) {
                box.innerHTML = `<h2 class="text-xl font-bold text-red-400">Opportunity Not Found</h2><p class="text-slate-400 mt-2">The requested ID does not exist.</p>`;
                return;
            }

            const hasValidUrl = opp.officialUrl && opp.officialUrl !== '#' && (opp.officialUrl.startsWith('http://') || opp.officialUrl.startsWith('https://'));

            box.innerHTML = `
                <div class="flex justify-between items-start gap-4 mb-4">
                    <span class="text-xs text-gold font-bold uppercase tracking-wider bg-royalBlue/30 px-3 py-1 rounded-md border border-gold/20">
                        ${escapeHtml(opp.category)}
                    </span>
                    <span class="bg-slate-800 text-slate-300 text-xs px-3 py-1 rounded-full border border-slate-700">
                        ${escapeHtml(opp.status)}
                    </span>
                </div>
                <h1 class="text-3xl font-extrabold text-white mb-2">${escapeHtml(opp.title)}</h1>
                <p class="text-gold font-medium mb-6">${escapeHtml(opp.organization)} &bull; ${escapeHtml(opp.location)}</p>
                
                <div class="border-t border-b border-slate-800 py-6 my-6 space-y-4 text-slate-300 text-sm md:text-base">
                    <p><strong>Eligibility:</strong> ${escapeHtml(opp.eligibility)}</p>
                    <p><strong>Deadline:</strong> ${escapeHtml(opp.deadline)}</p>
                    <p><strong>Verification Status:</strong> ${escapeHtml(opp.verification)}</p>
                    <p><strong>Description:</strong> ${escapeHtml(opp.description)}</p>
                </div>

                <div class="flex flex-wrap gap-4 items-center pt-2">
                    ${hasValidUrl 
                        ? `<a href="${escapeHtml(opp.officialUrl)}" target="_blank" rel="noopener noreferrer" class="bg-gold hover:bg-goldHover text-darkNavy font-bold px-6 py-3 rounded-xl text-sm transition inline-flex items-center gap-2 shadow-lg">Visit Official Website <i class="fa-solid fa-arrow-up-right-from-square text-xs"></i></a>` 
                        : `<button class="bg-slate-800 text-slate-500 font-semibold px-6 py-3 rounded-xl text-sm cursor-not-allowed border border-slate-700" disabled>Official link not available yet.</button>`}
                    
                    <button onclick="toggleSaveOpportunity('${escapeHtml(opp.id)}'); switchView('details', '${escapeHtml(opp.id)}');" class="border border-slate-700 hover:border-gold text-slate-300 hover:text-gold px-6 py-3 rounded-xl text-sm transition">
                        ${isOpportunitySaved(opp.id) ? 'Saved in Dashboard' : 'Save Opportunity'}
                    </button>
                </div>
            `;
        }

        function getSavedIds() {
            try { return JSON.parse(localStorage.getItem(SAVED_KEY) || '[]'); } catch (e) { return []; }
        }

        function isOpportunitySaved(id) {
            return getSavedIds().includes(id);
        }

        function toggleSaveOpportunity(id) {
            let saved = getSavedIds();
            if (saved.includes(id)) {
                saved = saved.filter(i => i !== id);
            } else {
                saved.push(id);
            }
            localStorage.setItem(SAVED_KEY, JSON.stringify(saved));
            
            if (document.getElementById('view-directory').classList.contains('active')) renderDirectoryGrid();
            if (document.getElementById('view-home').classList.contains('active')) renderHomeViews();
            if (document.getElementById('view-dashboard').classList.contains('active')) renderDashboardView();
        }

        function getUsersList() {
            try { return JSON.parse(localStorage.getItem(USERS_KEY) || '[]'); } catch (e) { return []; }
        }

        function getCurrentUserSession() {
            try { return JSON.parse(localStorage.getItem(CURRENT_USER_KEY)); } catch (e) { return null; }
        }

        function handleUserRegister(e) {
            e.preventDefault();
            const fullName = document.getElementById('regNameInput').value.trim();
            const email = document.getElementById('regEmailInput').value.trim().toLowerCase();
            const password = document.getElementById('regPassInput').value;
            const confirmPass = document.getElementById('regConfirmPassInput').value;
            const alertBox = document.getElementById('registerAlertBox');

            if (password !== confirmPass) {
                showAlert(alertBox, 'Passwords do not match.', 'error');
                return;
            }

            let users = getUsersList();
            if (users.some(u => u.email === email)) {
                showAlert(alertBox, 'An account with this email already exists. Please sign in.', 'error');
                return;
            }

            const newUser = { fullName, email, password, registrationDate: new Date().toISOString() };
            users.push(newUser);
            localStorage.setItem(USERS_KEY, JSON.stringify(users));
            localStorage.setItem(CURRENT_USER_KEY, JSON.stringify({ fullName, email }));

            updateNavAuthState();
            switchView('dashboard');
        }

        function handleUserLogin(e) {
            e.preventDefault();
            const email = document.getElementById('loginEmailInput').value.trim().toLowerCase();
            const password = document.getElementById('loginPassInput').value;
            const alertBox = document.getElementById('loginAlertBox');

            let users = getUsersList();
            const found = users.find(u => u.email === email);

            if (!found) {
                showAlert(alertBox, 'Account not found. Please register first.', 'error');
                return;
            }
            if (found.password !== password) {
                showAlert(alertBox, 'Incorrect password. Please try again.', 'error');
                return;
            }

            localStorage.setItem(CURRENT_USER_KEY, JSON.stringify({ fullName: found.fullName, email: found.email }));
            updateNavAuthState();
            switchView('dashboard');
        }

        function handleSignOut() {
            localStorage.removeItem(CURRENT_USER_KEY);
            updateNavAuthState();
            switchView('home');
        }

        function showAlert(el, msg, type) {
            el.className = `p-3 mb-4 rounded-xl text-sm ${type === 'error' ? 'bg-red-900/40 border border-red-500 text-red-200' : 'bg-green-900/40 border border-green-500 text-green-200'}`;
            el.innerText = msg;
            el.classList.remove('hidden');
        }

        function updateNavAuthState() {
            const user = getCurrentUserSession();
            const navAuth = document.getElementById('authNavButtons');
            const navUser = document.getElementById('userNavSession');
            const mobileAuth = document.getElementById('mobileAuthContainer');

            if (user) {
                if (navAuth) navAuth.classList.add('hidden');
                if (navUser) {
                    navUser.classList.remove('hidden');
                    navUser.classList.add('flex');
                    document.getElementById('navUserEmailDisplay').innerText = user.fullName || user.email;
                }
                if (mobileAuth) {
                    mobileAuth.innerHTML = `
                        <div class="text-xs text-gold font-semibold py-1">Signed in as ${escapeHtml(user.fullName || user.email)}</div>
                        <button onclick="handleSignOut(); toggleMobileMenu();" class="w-full text-center py-2.5 bg-red-900/40 border border-red-500 text-red-200 rounded-xl text-sm font-semibold">Sign Out</button>
                    `;
                }
            } else {
                if (navAuth) navAuth.classList.remove('hidden');
                if (navUser) {
                    navUser.classList.remove('flex');
                    navUser.classList.add('hidden');
                }
                if (mobileAuth) {
                    mobileAuth.innerHTML = `
                        <a href="#login" onclick="switchView('login'); toggleMobileMenu();" class="w-full text-center py-2.5 text-slate-300 border border-slate-700 rounded-xl text-sm">Sign In</a>
                        <a href="#register" onclick="switchView('register'); toggleMobileMenu();" class="w-full text-center py-2.5 bg-gold text-darkNavy font-bold rounded-xl text-sm">Create Account</a>
                    `;
                }
            }
        }

        function renderDashboardView() {
            const user = getCurrentUserSession();
            if (!user) return;

            document.getElementById('dashProfileName').innerText = user.fullName || 'User';
            document.getElementById('dashProfileEmail').innerText = user.email || '';

            const savedIds = getSavedIds();
            document.getElementById('dashSavedCount').innerText = savedIds.length;

            const allOpp = getOpportunities();
            document.getElementById('dashTotalCount').innerText = allOpp.length;

            const savedOpp = allOpp.filter(o => savedIds.includes(o.id));
            const container = document.getElementById('dashSavedList');

            if (savedOpp.length === 0) {
                container.innerHTML = `<div class="col-span-full bg-navy/50 p-8 rounded-2xl border border-slate-800 text-center text-slate-400">You have not saved any opportunities yet. Browse the directory to save items.</div>`;
            } else {
                container.innerHTML = savedOpp.map(o => createCardHtml(o)).join('');
            }
        }

        function renderAdminView() {
            const list = document.getElementById('adminOpportunitiesList');
            const data = getOpportunities();
            list.innerHTML = data.map(o => `
                <div class="bg-darkNavy p-4 rounded-xl border border-slate-800 flex justify-between items-center gap-4">
                    <div>
                        <h3 class="font-bold text-white text-sm">${escapeHtml(o.title)}</h3>
                        <p class="text-xs text-slate-400">${escapeHtml(o.category)} &bull; Status: ${escapeHtml(o.status)}</p>
                    </div>
                    <span class="text-xs bg-royalBlue/40 text-gold px-3 py-1 rounded-lg border border-gold/20 font-medium">${escapeHtml(o.verification)}</span>
                </div>
            `).join('');
        }

        function toggleMobileMenu() {
            const menu = document.getElementById('mobileMenu');
            const icon = document.getElementById('mobileMenuIcon');
            menu.classList.toggle('hidden');
            icon.classList.toggle('fa-bars');
            icon.classList.toggle('fa-xmark');
        }

        window.addEventListener('DOMContentLoaded', () => {
            updateNavAuthState();
            const hash = window.location.hash.replace('#', '');
            if (hash && document.getElementById(`view-${hash}`)) {
                switchView(hash);
            } else {
                switchView('home');
            }
        });

        window.addEventListener('popstate', () => {
            const hash = window.location.hash.replace('#', '');
            if (hash && document.getElementById(`view-${hash}`)) {
                switchView(hash);
            }
        });
    </script>
